#!/bin/bash
# Helper for the Hotkey Wheel plugin. It never runs a wheel slot.
#
# hotkey-wheel records   Omarchy's keybinding records ("COMBO → Description<TAB>dispatcher<TAB>arg"),
#                        from its own SUPER + K reader, for the picker's Keybindings tab.
# hotkey-wheel state     "setup" or "not-setup", then one "conflict<TAB><trigger><TAB><description>"
#                        line for each trigger another binding already uses.
# hotkey-wheel setup     Adds the Hotkey Wheel lines to ~/.config/hypr/bindings.lua (once) and
#                        reloads Hyprland. Run only on request.
# hotkey-wheel unsetup   Removes that block again and reloads Hyprland.
# hotkey-wheel apply     Reloads Hyprland so a changed trigger or On switch takes effect.
#
# Errors go to stderr as one line and the exit status is non-zero.

plugin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
hypr_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
bindings_file="$hypr_dir/bindings.lua"
settings_file="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/hotkey-wheel.json"
lua_path=${plugin_dir//\\/\\\\}
lua_path=${lua_path//\"/\\\"}
# Loads bindings.lua only while it exists: removing the plugin (Omarchy's
# menu just deletes its folder) must not break the rest of the config.
setup_line="do local p = \"$lua_path/bindings.lua\" local f = io.open(p) if f then f:close() dofile(p) end end"
# Versions before 0.7.3 wrote a plain dofile; that block is still recognised
# so it can be removed.
old_setup_line="dofile(\"$lua_path/bindings.lua\")"

fail() {
  echo "$*" >&2
  exit 1
}

# --- Keybinding records ------------------------------------------------------
# Reuses omarchy-menu-keybindings by sourcing everything before its entry
# point. If that line ever changes, fail instead of sourcing the menu, which
# would open it.
records() {
  local script menu='^if \[\[ \$1 == "--print"'
  script=$(command -v omarchy-menu-keybindings) || fail "omarchy-menu-keybindings not found"
  grep -q "$menu" "$script" || fail "omarchy-menu-keybindings changed; cannot read its binds"
  source <(sed "/$menu/,\$d" "$script")
  declare -F output_binding_records >/dev/null || fail "omarchy-menu-keybindings changed; cannot read its binds"
  output_binding_records
}

# --- Setup ---------------------------------------------------------------------
# Setup writes one marked block and removal deletes exactly that block (all
# three lines, in order, unchanged). No other line of the file is interpreted
# or touched. Whether it is loaded is asked of Hyprland itself, so a line
# added by hand counts as set up too (and is left for the user to remove).
block_begin="-- >>> io.github.erikrjohansson.hotkey-wheel: added by Hotkey Wheel's Set up (remove with hotkey-wheel unsetup)"
block_end="-- <<< io.github.erikrjohansson.hotkey-wheel"
block_text="$block_begin"$'\n'"$setup_line"$'\n'"$block_end"$'\n'
old_block_text="$block_begin"$'\n'"$old_setup_line"$'\n'"$block_end"$'\n'
found_block=""

# The file's bytes, trailing newlines included; fails when it cannot be read.
file_text() {
  local text
  text=$(cat -- "$bindings_file" && printf x) || return 1
  printf '%s' "${text%x}"
}

# Replaces the file's contents in one step, keeping its permissions, so a
# failure never leaves it empty or half written.
write_bindings() {
  local target tmp
  target=$(readlink -f -- "$bindings_file") || return 1
  tmp=$(mktemp -- "$(dirname -- "$target")/.bindings.lua.XXXXXX") || return 1
  if printf '%s' "$1" >"$tmp" && chmod --reference="$target" -- "$tmp" && mv -f -- "$tmp" "$target"; then
    return 0
  fi
  rm -f -- "$tmp"
  return 1
}

# Whether the file holds Set up's block (or an older version's); sets
# found_block to the exact text found.
has_block() {
  [[ -f $bindings_file ]] || return 1
  local text candidate
  text=$(file_text && printf x) || return 1
  text=${text%x}
  for candidate in "$block_text" "$old_block_text"; do
    if [[ $text == "$candidate"* || $text == *$'\n'"$candidate"* ]]; then
      found_block=$candidate
      return 0
    fi
  done
  return 1
}

# Hyprland's bindings as "modmask<TAB>key<TAB>description<TAB>dispatcher" lines.
# The plain output is parsed because `hyprctl -j binds` is not valid JSON on 0.56.
binds() {
  hyprctl binds 2>/dev/null | awk '
    function emit() { if (seen) printf "%s\t%s\t%s\t%s\n", f["modmask"], f["key"], f["description"], f["dispatcher"]; seen = 0 }
    /^bind/ { emit(); seen = 1; delete f; next }
    seen && match($0, /^\t[a-z]+: /) { f[substr($0, 2, RLENGTH - 3)] = substr($0, RLENGTH + 1) }
    END { emit() }'
}

loaded() {
  binds | awk -F '\t' '$3 == "Hotkey Wheel (hold)" { found = 1 } END { exit !found }'
}

# The drawer's On switch is off: bindings.lua then binds nothing, so Hyprland
# cannot tell whether it is loaded and the file is asked instead.
switched_off() {
  [[ -f $settings_file ]] && grep -Eq '"enabled"[[:space:]]*:[[:space:]]*false' "$settings_file"
}

# A Lua file in the Hyprland config folder loads this plugin's bindings.lua,
# by Set up or by hand. Links are followed (a stow-style linked file or
# folder). Pipes and devices are skipped and the search gives up after 3
# seconds, so a link into a large tree can't hang the drawer. Prints the
# files; with -q it only answers (stopping at the first). Returns 0 when
# found, 1 when not, and 2 when the search was cut short, so callers never
# take an unfinished search for "not there".
mentioned() {
  [[ -d $hypr_dir ]] || return 1
  local needle="io.github.erikrjohansson.hotkey-wheel/bindings.lua" out="" status
  if [[ ${1:-} == -q ]]; then
    timeout 3 grep -RqF --devices=skip --include='*.lua' "$needle" -- "$hypr_dir" 2>/dev/null
    status=$?
  else
    out=$(timeout 3 grep -RlF --devices=skip --include='*.lua' "$needle" -- "$hypr_dir" 2>/dev/null)
    status=$?
  fi
  (( status == 124 || status == 137 )) && return 2
  # grep goes on past broken links and files it can't read, and then exits 2.
  # A broken link can't hold the line, but an unreadable Lua file might.
  if [[ $status != 0 && -z $out ]]; then
    (( status == 1 )) && return 1
    local unreadable
    unreadable=$(timeout 3 find -L "$hypr_dir" -name '*.lua' -type f ! -readable -print -quit 2>/dev/null)
    (( $? == 124 )) || [[ -n $unreadable ]] && return 2
    return 1
  fi
  [[ -n $out ]] && printf '%s\n' "$out"
  return 0
}

unfinished() {
  fail "could not finish searching $hypr_dir for a line that loads Hotkey Wheel$1"
}

# Whether Hyprland should bind the trigger after a reload.
want_loaded() {
  if switched_off; then echo false; else echo true; fi
}

state() {
  local list
  list=$(binds) || fail "could not read Hyprland's bindings"
  [[ -n $list ]] || fail "could not read Hyprland's bindings"
  local wired=false
  if awk -F '\t' '$3 == "Hotkey Wheel (hold)" { found = 1 } END { exit !found }' <<<"$list" || has_block; then
    wired=true
  elif switched_off; then
    mentioned -q
    case $? in 0) wired=true ;; 2) unfinished "" ;; esac
  fi
  if [[ $wired == true ]]; then echo setup; else echo not-setup; fi
  # Presses other bindings already use (SUPER is modmask 64; keys are as
  # Lua binds report them, with modifiers spelled out). While the wheel is
  # loaded, bindings.lua keeps one unnamed bind on each other mouse button
  # (switched off until a hold); those are the wheel's own, not conflicts.
  local own
  own=$(awk -F '\t' '$3 == "Hotkey Wheel (release)" { print $2; exit }' <<<"$list")
  awk -F '\t' -v own="$own" '
    $3 ~ /^Hotkey Wheel/ { next }
    { key = $2; sub(/^.* \+ /, "", key) }
    own != "" && $1 == 0 && $3 == "" && $4 == "__lua" && key ~ /^mouse:27[2456]$/ && key != own && !(key in skipped) {
      skipped[key] = 1; next
    }
    { what = $3 == "" ? "another binding" : $3 }
    key == "mouse:274" && $1 == 0  { print "conflict\tmiddle\t" what }
    key == "mouse:274" && $1 == 64 { print "conflict\tsuper-middle\t" what }
    key == "mouse:275" && $1 == 0  { print "conflict\tback\t" what }
    key == "mouse:276" && $1 == 0  { print "conflict\tforward\t" what }' <<<"$list"
}

reload_and_check() {
  local want=$1 errors
  hyprctl reload >/dev/null 2>&1 || fail "hyprctl reload failed"
  sleep 0.3
  errors=$(hyprctl configerrors 2>/dev/null) || fail "could not ask Hyprland for config errors"
  errors=$(grep -v '^[[:space:]]*$' <<<"$errors")
  [[ -n $errors ]] && fail "Hyprland reports a config error: $(head -n1 <<<"$errors")"
  if [[ $want == true ]]; then loaded; else ! loaded; fi
}

setup() {
  if loaded; then echo setup; return; fi
  local existed=false original="" added=false text="" wired=0
  if ! has_block; then
    mentioned -q
    wired=$?
    (( wired == 2 )) && unfinished ", so nothing was added"
  fi
  if ! has_block && (( wired == 1 )); then
    mkdir -p "$(dirname "$bindings_file")" || fail "could not create $(dirname "$bindings_file")"
    if [[ -e $bindings_file ]]; then
      existed=true
      original=$(file_text && printf x) || fail "could not read $bindings_file"
      original=${original%x}
    fi
    # The whole new file is written in one step, so a failed write leaves the
    # old one as it was.
    text=$original
    [[ -n $text && $text != *$'\n' ]] && text+=$'\n'
    text+=$block_text
    if [[ $existed == true ]]; then
      write_bindings "$text" || fail "could not write $bindings_file"
    else
      printf '%s' "$text" >"$bindings_file" || { rm -f -- "$bindings_file"; fail "could not write $bindings_file"; }
    fi
    added=true
  fi
  # If Hyprland can't take the line (say the file ends in a `return`), the
  # file goes back to exactly what it was, unless it changed meanwhile.
  local error current
  if ! error=$( (reload_and_check "$(want_loaded)") 2>&1 >/dev/null); then
    error=${error:-Hyprland did not load Hotkey Wheel after the reload}
    if [[ $added == true ]]; then
      current=$(file_text && printf x) && current=${current%x}
      if [[ $current != "$text" ]]; then
        fail "$error. $bindings_file changed meanwhile, so it was left as it is; remove the Hotkey Wheel lines from it by hand"
      fi
      local restored=true
      if [[ $existed == true ]]; then write_bindings "$original" || restored=false; else rm -f -- "$bindings_file" || restored=false; fi
      hyprctl reload >/dev/null 2>&1
      [[ $restored == true ]] || fail "$error. Could not put $bindings_file back; remove the Hotkey Wheel lines from it by hand"
      fail "$error. $bindings_file was put back as it was; add the line by hand (see the README)"
    fi
    fail "$error"
  fi
  echo setup
}

unsetup() {
  omarchy-shell io.github.erikrjohansson.hotkey-wheel cancel >/dev/null 2>&1
  if has_block; then
    # Drop the first exact copy of the block; every other byte stays as it is.
    local text
    text=$(file_text && printf x) || fail "could not read $bindings_file"
    text=${text%x}
    if [[ $text == "$found_block"* ]]; then
      text=${text#"$found_block"}
    else
      text=${text/$'\n'"$found_block"/$'\n'}
    fi
    write_bindings "$text" || fail "could not write $bindings_file"
  fi
  # A line added by hand would load a missing file once the plugin is gone.
  local still status
  still=$(mentioned)
  status=$?
  if (( status == 0 )); then
    hyprctl reload >/dev/null 2>&1
    fail "$(head -n1 <<<"$still") still loads Hotkey Wheel through a line not added by Set up; remove that line by hand"
  fi
  if (( status == 2 )); then
    hyprctl reload >/dev/null 2>&1
    unfinished "; check it by hand before removing the plugin"
  fi
  if ! reload_and_check false; then
    fail "Hotkey Wheel is still loaded by a line not added by Set up (in $bindings_file or a file it loads); remove that line by hand"
  fi
  echo not-setup
}

# After the trigger or the On switch changed.
apply() {
  # An unfinished search reloads anyway: reloading is harmless.
  if ! loaded && ! has_block; then
    mentioned -q
    (( $? == 1 )) && { echo not-setup; return; }
  fi
  if [[ $(want_loaded) == true ]]; then
    reload_and_check true || fail "Hyprland did not load Hotkey Wheel after the reload"
  else
    reload_and_check false || fail "Hyprland still binds the wheel after the reload"
  fi
  echo setup
}

case "${1:-}" in
  records) records ;;
  state) state ;;
  setup) setup ;;
  unsetup) unsetup ;;
  apply) apply ;;
  *) fail "usage: hotkey-wheel [records|state|setup|unsetup|apply]" ;;
esac
